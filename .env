# ════════════════════════════════════════════════════════════════════════════════════
# Flask & Security Configuration
# ════════════════════════════════════════════════════════════════════════════════════

# Secret key for Flask session management - Generate a strong random string
# Run this in Python to generate: import secrets; print(secrets.token_hex(32))
SECRET_KEY=your_super_secret_key_here_change_this_to_a_random_value

# Flag to detect Vercel environment
VERCEL=true

# ════════════════════════════════════════════════════════════════════════════════════
# Database Configuration
# ════════════════════════════════════════════════════════════════════════════════════

# Use PostgreSQL on Vercel (recommended)
# Format: postgresql://username:password@host:port/database
# Get this from your PostgreSQL/Neon/Supabase provider
DATABASE_URL=postgresql://user:password@host:5432/javamastery_db

# Alternative: if using Supabase or another provider
POSTGRES_URL=postgresql://user:password@host:5432/javamastery_db

# ════════════════════════════════════════════════════════════════════════════════════
# Email Configuration (for password reset, notifications)
# ════════════════════════════════════════════════════════════════════════════════════

# Gmail SMTP Settings (recommended for testing)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password
MAIL_DEFAULT_SENDER=your_email@gmail.com

# Note: For Gmail, use an "App Password" not your regular password
# 1. Enable 2-Factor Authentication on Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Generate an app password for "Mail"
# 4. Copy that 16-character password here

# Alternative: Use SendGrid, Mailgun, or other SMTP provider
# Just update MAIL_SERVER, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD accordingly

# ════════════════════════════════════════════════════════════════════════════════════
# Admin Account Setup
# ════════════════════════════════════════════════════════════════════════════════════

# Change these to your desired admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=javamastery
ADMIN_EMAIL=admin@example.com

# Setup key to create admin user (for security)
# Change this to a random string - only you should know it
# After creating admin, you can keep or remove this from .env
SETUP_KEY=your_secure_setup_key_here

# ════════════════════════════════════════════════════════════════════════════════════
# Optional: Additional Settings
# ════════════════════════════════════════════════════════════════════════════════════

# Enable debug mode (set to False in production)
FLASK_ENV=production
FLASK_DEBUG=False

# ════════════════════════════════════════════════════════════════════════════════════
# HOW TO SETUP ON VERCEL
# ════════════════════════════════════════════════════════════════════════════════════
#
# 1. Push code to GitHub
#
# 2. Go to https://vercel.com and connect your GitHub repo
#
# 3. In Vercel Dashboard > Settings > Environment Variables:
#    - Add all variables from this .env file
#    - IMPORTANT: Do NOT commit .env to GitHub - it contains secrets
#    - Instead, add each variable individually in Vercel dashboard
#
# 4. Set up PostgreSQL database:
#    Option A: Use Neon (free tier available)
#    - Sign up at https://neon.tech
#    - Create a project and database
#    - Copy the connection string to DATABASE_URL in Vercel
#
#    Option B: Use Supabase (free tier available)
#    - Sign up at https://supabase.com
#    - Create project and get connection string
#    - Copy to DATABASE_URL/POSTGRES_URL in Vercel
#
#    Option C: Use Vercel PostgreSQL (beta)
#    - Available in Vercel dashboard under Storage
#
# 5. Deploy and test:
#    - Deploy changes to Vercel
#    - Visit: https://your-app.vercel.app/debug_check
#    - Check if environment variables loaded correctly
#
# 6. Create admin user:
#    - Visit: https://your-app.vercel.app/create_admin?key=YOUR_SETUP_KEY
#    - Replace YOUR_SETUP_KEY with the SETUP_KEY from your env variables
#
# ════════════════════════════════════════════════════════════════════════════════════
